<Page x:Class="FrostyStandaloneInstaller.Pages.TaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:FrostyStandaloneInstaller.Pages"
      xmlns:ctrl="clr-namespace:Frosty.Controls;assembly=FrostyControls"
      mc:Ignorable="d" 
      d:DesignHeight="375" d:DesignWidth="600"
      Title="TaskPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource ListBackground}"/>
        <Grid Grid.Row="0" Margin="20" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="15">
                <Label x:Name="CurrentTaskTitle" Content="Current Task"/>
                <Grid>
                    <ProgressBar x:Name="CurrentTaskProgressBar" Height="25" Margin="5"  VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="7.5, 0, 0, 0">
                        <ctrl:FrostySpinner Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Label x:Name="CurrentTaskStatus" Content="Current Status" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="15">
                <Label Content="Total Progress"/>
                <ProgressBar x:Name="TotalTaskProgressBar" Height="25" Margin="5"/>
            </StackPanel>
        </Grid>
        <WrapPanel Grid.Row="1" Margin="5" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="70" Height="25" Margin="5" IsEnabled="False"/>
        </WrapPanel>
    </Grid>
</Page>
